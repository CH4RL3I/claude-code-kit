#!/usr/bin/env python3
"""holdout: manage hidden acceptance scenarios outside the repo (default ~/.holdouts).

Config: env HOLDOUTS_DIR overrides the storage directory.
"""
import os, re, sys
from pathlib import Path

NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")


def root():
    custom = os.environ.get("HOLDOUTS_DIR")
    return Path(custom).expanduser() if custom else Path(os.path.expanduser("~")) / ".holdouts"


def check(*names):
    for n in names:
        if not NAME.match(n) or ".." in n:
            sys.exit(f"holdout: invalid name {n!r} (use letters, digits, . _ -)")


def main(argv):
    if len(argv) < 2 or argv[1] not in ("add", "ls", "path"):
        sys.exit("usage: holdout add <project> <slug> < file.md | ls [project] | path <project> <slug>")
    cmd, args = argv[1], argv[2:]
    if cmd == "add":
        if len(args) != 2:
            sys.exit("usage: holdout add <project> <slug>")
        check(*args)
        data = sys.stdin.read()
        if not data.strip():
            sys.exit("holdout: empty input")
        d = root() / args[0]
        d.mkdir(parents=True, exist_ok=True)
        os.chmod(root(), 0o700)
        os.chmod(d, 0o700)
        p = d / f"{args[1]}.md"
        p.write_text(data)
        os.chmod(p, 0o600)
        print(p)
    elif cmd == "ls":
        if len(args) > 1:
            sys.exit("usage: holdout ls [project]")
        base = root()
        if args:
            check(args[0])
            dirs = [base / args[0]]
        else:
            dirs = sorted(x for x in base.glob("*") if x.is_dir()) if base.exists() else []
        for d in dirs:
            for f in sorted(d.glob("*.md")) if d.exists() else []:
                print(f"{d.name}/{f.stem}")
    else:
        if len(args) != 2:
            sys.exit("usage: holdout path <project> <slug>")
        check(*args)
        p = root() / args[0] / f"{args[1]}.md"
        if not p.exists():
            sys.exit(f"holdout: not found: {p}")
        print(p)


if __name__ == "__main__":
    main(sys.argv)
