#!/usr/bin/env python3
"""Remove git worktrees whose work is safely on the remote.

A worktree is removed only when all of these hold:
  - it is not the repo's main checkout and not locked,
  - `git status --porcelain` is empty (no changes, no untracked files),
  - its commits are on the remote: the branch has an upstream and nothing is
    ahead of it, or (detached / no upstream) HEAD is contained in a remote branch,
  - no process has its working directory inside it (a running session keeps it).
The branch itself is kept; only the folder goes (`git worktree remove`, no --force).

  worktree-cleanup           dry run, prints what it would do
  worktree-cleanup --really  remove
  worktree-cleanup hook      hook mode: start a detached --really run, return at once

Where to look (nothing is scanned unless you configure it):
  env WORKTREE_CLEANUP_ROOTS   colon-separated directories that contain your repos
  file ~/.config/worktree-cleanup/roots.txt   one directory per line, "#" comments
Each root is scanned one and two levels deep for directories that contain a `.git` directory.
Log of removals: ~/.cache/worktree-cleanup/cleanup.log (env WORKTREE_CLEANUP_HOME moves the state dir).
"""
import fcntl, json, os, subprocess, sys, time
from pathlib import Path

HOME = Path.home()
STATE = Path(os.environ.get("WORKTREE_CLEANUP_HOME") or HOME / ".cache" / "worktree-cleanup")
ROOTS_FILE = HOME / ".config" / "worktree-cleanup" / "roots.txt"


def roots():
    out = []
    for r in os.environ.get("WORKTREE_CLEANUP_ROOTS", "").split(":"):
        if r.strip():
            out.append(Path(r.strip()).expanduser())
    if ROOTS_FILE.is_file():
        for line in ROOTS_FILE.read_text().splitlines():
            line = line.strip()
            if line and not line.startswith("#"):
                out.append(Path(line).expanduser())
    return out


def git(repo, *args, timeout=30):
    r = subprocess.run(["git", "-C", str(repo), *args], capture_output=True, text=True, timeout=timeout)
    return r.returncode, r.stdout.strip()


def repos():
    for root in roots():
        if not root.is_dir():
            continue
        for d in sorted(root.iterdir()):
            if (d / ".git").is_dir():
                yield d
            elif d.is_dir():  # one level deeper, e.g. ~/code/group/repo
                for sub in sorted(d.iterdir()):
                    if (sub / ".git").is_dir():
                        yield sub


def worktrees(repo):
    code, out = git(repo, "worktree", "list", "--porcelain")
    if code:
        return []
    items, cur = [], {}
    for line in out.splitlines() + [""]:
        if not line:
            if cur:
                items.append(cur)
            cur = {}
            continue
        key, _, val = line.partition(" ")
        cur[key] = val or True
    return items[1:]  # the first entry is the main checkout


def cwds_in_use():
    r = subprocess.run(["lsof", "-a", "-d", "cwd", "-Fn"], capture_output=True, text=True, timeout=30)
    return [l[1:] for l in r.stdout.splitlines() if l.startswith("n/")]


def verdict(wt, busy):
    path = wt["worktree"]
    if not Path(path).is_dir():
        return False, "folder already gone (git worktree prune cleans the entry)"
    if wt.get("locked"):
        return False, "locked"
    real = os.path.realpath(path)
    if any(c in (path, real) or c.startswith((path + "/", real + "/")) for c in busy):
        return False, "a process is working in it"
    code, status = git(path, "status", "--porcelain")
    if code or status:
        return False, "has uncommitted or untracked changes"
    code, _ = git(path, "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}")
    if code == 0:
        code, ahead = git(path, "rev-list", "--count", "@{u}..HEAD")
        if code or ahead != "0":
            return False, f"{ahead} commits not pushed"
        return True, "branch fully pushed"
    code, remote = git(path, "branch", "-r", "--contains", "HEAD")
    if code == 0 and remote.strip():
        return True, "HEAD is on " + remote.split()[0]
    return False, "no upstream and HEAD is not on any remote branch"


def sweep(really):
    busy = cwds_in_use()
    lines = []
    for repo in repos():
        for wt in worktrees(repo):
            ok, why = verdict(wt, busy)
            name = wt["worktree"].replace(str(HOME), "~")
            if ok and really:
                code, out = git(repo, "worktree", "remove", wt["worktree"])
                lines.append(f"{'removed' if code == 0 else 'kept (git refused)'}: {name} ({why}){'' if code == 0 else ' ' + out}")
            else:
                lines.append(f"{'would remove' if ok else 'keep'}: {name} ({why})")
        if really:
            git(repo, "worktree", "prune")
    return lines


def main():
    args = sys.argv[1:]
    if args[:1] == ["hook"]:
        try:
            data = json.load(sys.stdin)
        except Exception:
            data = {}
        cmd = str((data.get("tool_input") or {}).get("command", ""))
        if data.get("hook_event_name") == "PostToolUse" and "git push" not in cmd:
            return 0
        if not roots():
            return 0
        subprocess.Popen([sys.executable, os.path.abspath(__file__), "--really", "--log"],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
        return 0
    if not roots():
        print("worktree-cleanup: no scan roots configured. Set WORKTREE_CLEANUP_ROOTS=/path/a:/path/b "
              f"or list directories in {ROOTS_FILE}.")
        return 0
    really = "--really" in args
    if really:
        STATE.mkdir(parents=True, exist_ok=True)
        lock = open(STATE / "cleanup.lock", "w")
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            return 0  # another sweep is running; it covers this one
    lines = sweep(really)
    if "--log" in args:
        changed = [l for l in lines if l.startswith("removed") or l.startswith("kept (git")]
        if changed:
            with (STATE / "cleanup.log").open("a") as f:
                f.write(f"== {time.strftime('%Y-%m-%d %H:%M:%S')}\n" + "\n".join(changed) + "\n")
    else:
        print("\n".join(lines) or "no worktrees")
    return 0


if __name__ == "__main__":
    sys.exit(main())
